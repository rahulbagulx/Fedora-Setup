#!/bin/bash

# ============================================
# Fedora Ultimate Cleanup Tool
# System-wide cleanup utility for Fedora 43+
# Usage: sudo cleanall [OPTIONS]
# ============================================

VERSION="3.2"
CONFIG_FILE="/etc/cleanall.conf"
LOG_FILE="/var/log/cleanall.log"
BACKUP_DIR="/var/backups/cleanall"

# Colors for output (fixed for proper escaping)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Check if running with sudo
if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}Error: This script must be run as root/sudo${NC}"
    echo "Usage: sudo cleanall [OPTIONS]"
    exit 1
fi

# Create backup directory
mkdir -p "$BACKUP_DIR"

# Function to print with timestamp
log_message() {
    local message="$1"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo -e "${CYAN}[$timestamp]${NC} $message" | tee -a "$LOG_FILE"
}

# Function to escape variables for echo -e
escape_chars() {
    echo "$1" | sed 's/\\/\\\\/g'
}

print_header() {
    clear
    echo -e "${BLUE}╔══════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║    ${BOLD}🛠️  FEDORA ULTIMATE CLEANUP TOOL v$VERSION${NC}${BLUE}    ║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════════════╝${NC}"
    log_message "Starting Fedora Cleanup Tool"
}

print_step() {
    local step=$(escape_chars "$1")
    echo -e "\n${GREEN}▶${NC} ${BOLD}$step${NC}"
    log_message "STEP: $1"
}

print_warning() {
    local warning=$(escape_chars "$1")
    echo -e "${YELLOW}⚠ $warning${NC}"
    log_message "WARNING: $1"
}

print_error() {
    local error=$(escape_chars "$1")
    echo -e "${RED}✗ $error${NC}"
    log_message "ERROR: $1"
}

print_success() {
    local success=$(escape_chars "$1")
    echo -e "${GREEN}✓ $success${NC}"
    log_message "SUCCESS: $1"
}

# Load configuration
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        source "$CONFIG_FILE"
        log_message "Loaded configuration from $CONFIG_FILE"
    else
        # Default configuration
        KEEP_KERNELS=3
        KEEP_LOGS_DAYS=7
        CLEAN_BROWSERS=1
        CLEAN_DOCKER=1
        CLEAN_FLATPAK=1
        CLEAN_SNAP=1
        CLEAN_THUMBNAILS=1
        REMOVE_OLD_KERNELS=1
        CLEAN_NPM=1
        CLEAN_PIP=1
        CLEAN_RUST=1
        log_message "Using default configuration"
    fi
}

# Show disk usage
show_disk_usage() {
    echo -e "\n${CYAN}📊 DISK USAGE REPORT${NC}"
    echo "──────────────────────────────────────"
    
    echo -e "${BOLD}Root Partition:${NC}"
    df -h / | awk 'NR==2 {print "  " $3 "/" $2 " used (" $5 ")"}'
    
    # Check package cache size
    if [[ -d /var/cache/dnf ]]; then
        DNF_CACHE_SIZE=$(du -sh /var/cache/dnf 2>/dev/null | cut -f1 || echo "0B")
        echo -e "${BOLD}DNF Cache:${NC} $DNF_CACHE_SIZE"
    fi
    
    # Check journal log size
    JOURNAL_SIZE=$(journalctl --disk-usage 2>/dev/null | cut -d' ' -f7-8 || echo "0B")
    echo -e "${BOLD}Journal Logs:${NC} $JOURNAL_SIZE"
    
    # Show home directory usage
    if mountpoint -q /home; then
        HOME_USAGE=$(df -h /home | awk 'NR==2 {print $5}' 2>/dev/null || echo "N/A")
        echo -e "${BOLD}Home Partition:${NC} $HOME_USAGE used"
    fi
}

# Clean DNF cache
clean_dnf() {
    print_step "Cleaning Package Manager Cache"
    
    # Show before size
    local before_size=$(du -sh /var/cache/dnf 2>/dev/null | cut -f1 || echo "0B")
    
    # Clean all dnf cache
    dnf clean all
    
    # Remove cached packages and metadata
    rm -rf /var/cache/dnf/*
    rm -rf /var/cache/PackageKit/*
    
    # Remove orphaned packages
    dnf autoremove -y
    
    # Show after size
    local after_size=$(du -sh /var/cache/dnf 2>/dev/null | cut -f1 || echo "0B")
    echo -e "  ${CYAN}Cache:${NC} $before_size → $after_size"
    
    print_success "Package cache cleaned"
}

# Remove old kernels
remove_old_kernels() {
    if [[ "$REMOVE_OLD_KERNELS" == "1" ]]; then
        print_step "Removing old kernels (keeping $KEEP_KERNELS latest)"
        
        # Count kernels before
        local kernels_before=$(rpm -qa kernel kernel-core | wc -l)
        
        # Method 1: Using package-cleanup if available
        if command -v package-cleanup &> /dev/null; then
            package-cleanup --oldkernels --count=$KEEP_KERNELS -y 2>/dev/null
        # Method 2: Using dnf
        else
            # Remove old kernel packages
            dnf remove $(dnf repoquery --installonly --latest-limit=-$KEEP_KERNELS -q 2>/dev/null) -y 2>/dev/null || true
        fi
        
        # Count kernels after
        local kernels_after=$(rpm -qa kernel kernel-core | wc -l)
        local removed=$((kernels_before - kernels_after))
        
        if [[ $removed -gt 0 ]]; then
            echo -e "  ${CYAN}Removed:${NC} $removed old kernels"
        else
            echo -e "  ${CYAN}Status:${NC} No old kernels to remove"
        fi
        
        print_success "Kernel cleanup completed"
    fi
}

# Clean Flatpak
clean_flatpak() {
    if command -v flatpak &> /dev/null && [[ "$CLEAN_FLATPAK" == "1" ]]; then
        print_step "Cleaning Flatpak"
        
        # Check if flatpak has repositories
        if flatpak remotes &> /dev/null 2>&1; then
            # Remove unused flatpak runtimes and apps
            flatpak uninstall --unused -y --noninteractive 2>/dev/null || true
        fi
        
        # Clean flatpak cache directories
        rm -rf /var/tmp/flatpak-cache-* 2>/dev/null || true
        rm -rf /root/.cache/flatpak/* 2>/dev/null || true
        rm -rf /root/.local/share/flatpak/app/*/current/active/files/cache/* 2>/dev/null || true
        
        # Clean for all users
        for user_dir in /home/*; do
            if [[ -d "$user_dir" && "$user_dir" != "/home/lost+found" ]]; then
                username=$(basename "$user_dir")
                if id "$username" &>/dev/null; then
                    rm -rf "$user_dir/.cache/flatpak/*" 2>/dev/null || true
                    rm -rf "$user_dir/.local/share/flatpak/app/*/current/active/files/cache/*" 2>/dev/null || true
                fi
            fi
        done
        
        print_success "Flatpak cleaned"
    else
        print_warning "Flatpak not found or disabled in config"
    fi
}

# Clean temporary files
clean_temp_files() {
    print_step "Cleaning Temporary Files"
    
    local files_removed=0
    
    # System temp files (older than 1 day)
    files_removed=$((files_removed + $(find /tmp -type f -atime +1 -delete 2>/dev/null | wc -l)))
    files_removed=$((files_removed + $(find /var/tmp -type f -atime +1 -delete 2>/dev/null | wc -l)))
    
    # Clean per-user caches
    for user_dir in /home/*; do
        if [[ -d "$user_dir" && "$user_dir" != "/home/lost+found" ]]; then
            username=$(basename "$user_dir")
            
            if id "$username" &>/dev/null; then
                # Clean user caches
                files_removed=$((files_removed + $(find "$user_dir/.cache" -type f -atime +7 -delete 2>/dev/null | wc -l)))
                rm -rf "$user_dir/.thumbnails/*" 2>/dev/null || true
                rm -rf "$user_dir/.local/share/Trash/*" 2>/dev/null || true
                
                # Clean browser caches if enabled
                if [[ "$CLEAN_BROWSERS" == "1" ]]; then
                    # Firefox
                    rm -rf "$user_dir/.mozilla/firefox/*.default-release/Cache" 2>/dev/null || true
                    rm -rf "$user_dir/.cache/mozilla/firefox/*" 2>/dev/null || true
                    
                    # Chrome/Chromium
                    rm -rf "$user_dir/.config/google-chrome/Default/Cache" 2>/dev/null || true
                    rm -rf "$user_dir/.config/chromium/Default/Cache" 2>/dev/null || true
                    
                    # Brave
                    rm -rf "$user_dir/.config/BraveSoftware/Brave-Browser/Default/Cache" 2>/dev/null || true
                fi
            fi
        fi
    done
    
    # Clean root caches
    rm -rf /root/.cache/* 2>/dev/null || true
    rm -rf /root/.local/share/Trash/* 2>/dev/null || true
    
    echo -e "  ${CYAN}Files removed:${NC} $files_removed"
    print_success "Temporary files cleaned"
}

# Clean system logs
clean_logs() {
    print_step "Cleaning System Logs"
    
    # Vacuum journal logs
    journalctl --vacuum-time=${KEEP_LOGS_DAYS}d 2>/dev/null
    
    # Clean old log files
    find /var/log -type f -name "*.log.*" -mtime +30 -delete 2>/dev/null || true
    find /var/log -type f -name "*.gz" -mtime +30 -delete 2>/dev/null || true
    find /var/log -type f -name "*.bz2" -mtime +30 -delete 2>/dev/null || true
    find /var/log -type f -name "*.xz" -mtime +30 -delete 2>/dev/null || true
    
    # Clean dnf logs
    find /var/log -name "dnf.*" -mtime +7 -delete 2>/dev/null || true
    
    # Show journal size after cleanup
    local journal_after=$(journalctl --disk-usage 2>/dev/null | cut -d' ' -f7-8 || echo "0B")
    echo -e "  ${CYAN}Journal logs:${NC} $journal_after"
    
    print_success "System logs cleaned"
}

# Clean development caches
clean_dev_caches() {
    print_step "Cleaning Development Caches"
    
    # Clean for all users
    for user_dir in /home/*; do
        if [[ -d "$user_dir" && "$user_dir" != "/home/lost+found" ]]; then
            username=$(basename "$user_dir")
            
            if id "$username" &>/dev/null; then
                # NPM cache
                if [[ "$CLEAN_NPM" == "1" ]] && command -v npm &> /dev/null; then
                    sudo -u "$username" npm cache clean --force 2>/dev/null || true
                fi
                
                # PIP cache
                if [[ "$CLEAN_PIP" == "1" ]] && command -v pip &> /dev/null; then
                    sudo -u "$username" pip cache purge 2>/dev/null || true
                fi
                
                # Rust cache
                if [[ "$CLEAN_RUST" == "1" ]] && [[ -d "$user_dir/.cargo" ]]; then
                    rm -rf "$user_dir/.cargo/registry/cache/*" 2>/dev/null || true
                    rm -rf "$user_dir/.cargo/registry/src/*" 2>/dev/null || true
                fi
            fi
        fi
    done
    
    # Clean for root
    if [[ "$CLEAN_NPM" == "1" ]] && command -v npm &> /dev/null; then
        npm cache clean --force 2>/dev/null || true
    fi
    
    if [[ "$CLEAN_PIP" == "1" ]] && command -v pip &> /dev/null; then
        pip cache purge 2>/dev/null || true
    fi
    
    print_success "Development caches cleaned"
}

# Clean thumbnail caches
clean_thumbnails() {
    if [[ "$CLEAN_THUMBNAILS" == "1" ]]; then
        print_step "Cleaning Thumbnail Caches"
        
        # System thumbnail cache
        rm -rf /var/cache/thumbnails/* 2>/dev/null || true
        
        # Clean per-user thumbnail caches
        for user_dir in /home/*; do
            if [[ -d "$user_dir" && "$user_dir" != "/home/lost+found" ]]; then
                username=$(basename "$user_dir")
                if id "$username" &>/dev/null; then
                    rm -rf "$user_dir/.cache/thumbnails/*" 2>/dev/null || true
                    rm -rf "$user_dir/.thumbnails/*" 2>/dev/null || true
                fi
            fi
        done
        
        # Rebuild thumbnail cache if possible
        if command -v gtk-update-icon-cache &> /dev/null; then
            gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
        fi
        
        print_success "Thumbnail caches cleaned"
    fi
}

# Clean package cache aggressively
clean_package_cache_aggressive() {
    print_step "Deep Cleaning Package Cache"
    
    local before_size=$(du -sh /var/cache 2>/dev/null | cut -f1 || echo "0B")
    
    # Remove all cached RPM packages
    find /var/cache/dnf -name "*.rpm" -delete 2>/dev/null || true
    
    # Clean metadata cache
    rm -rf /var/cache/dnf/metadata.* 2>/dev/null || true
    
    # Clean other cache directories
    rm -rf /var/cache/ldconfig/* 2>/dev/null || true
    rm -rf /var/cache/man/* 2>/dev/null || true
    
    local after_size=$(du -sh /var/cache 2>/dev/null | cut -f1 || echo "0B")
    echo -e "  ${CYAN}Cache size:${NC} $before_size → $after_size"
    
    print_success "Deep package cache clean completed"
}

# System optimization
optimize_system() {
    print_step "Optimizing System"
    
    # Update font cache
    if command -v fc-cache &> /dev/null; then
        fc-cache -f 2>/dev/null || true
        echo -e "  ${CYAN}Font cache:${NC} Updated"
    fi
    
    # Update desktop database
    if command -v update-desktop-database &> /dev/null; then
        update-desktop-database 2>/dev/null || true
        echo -e "  ${CYAN}Desktop database:${NC} Updated"
    fi
    
    # Update GTK icon cache
    if command -v gtk-update-icon-cache &> /dev/null; then
        gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
        echo -e "  ${CYAN}Icon cache:${NC} Updated"
    fi
    
    # Sync filesystem
    sync
    echo -e "  ${CYAN}Filesystem:${NC} Synced"
    
    print_success "System optimization completed"
}

# Show cleanup summary
show_summary() {
    echo -e "\n${GREEN}══════════════════════════════════════════════${NC}"
    echo -e "${GREEN}         🎉 CLEANUP COMPLETED SUCCESSFULLY!         ${NC}"
    echo -e "${GREEN}══════════════════════════════════════════════${NC}"
    
    log_message "Cleanup completed successfully"
    
    # Show final disk usage
    echo -e "\n${CYAN}📈 FINAL SYSTEM STATUS${NC}"
    echo "──────────────────────────────────────"
    
    # Disk usage
    echo -e "${BOLD}Disk Usage After Cleanup:${NC}"
    df -h / | awk 'NR==2 {print "  " $3 "/" $2 " used (" $5 ")"}'
    
    # Memory status
    echo -e "\n${BOLD}Memory Status:${NC}"
    free -h | awk 'NR==2 {print "  " $3 "/" $2 " used (" $4 " free)"}'
    
    # Uptime
    echo -e "\n${BOLD}System Uptime:${NC}"
    uptime -p
    
    # Recommendations (with proper escaping)
    echo -e "\n${YELLOW}📋 RECOMMENDATIONS:${NC}"
    echo -e "  1. System reboot recommended for kernel changes"
    echo -e "  2. Check for updates: ${BOLD}dnf check-update${NC}"
    echo -e "  3. Monitor logs: ${BOLD}journalctl -f${NC}"
    echo -e "  4. Check disk usage: ${BOLD}df -h${NC}"
    
    # Log location
    echo -e "\n${BLUE}📝 Cleanup log saved to: $LOG_FILE${NC}"
    echo -e "  View with: ${BOLD}sudo cleanall --log${NC}"
}

# Full cleanup mode
full_cleanup() {
    print_header
    echo -e "${RED}⚠️  RUNNING FULL SYSTEM CLEANUP${NC}"
    echo -e "${YELLOW}This will clean ALL caches and temporary files${NC}\n"
    
    read -p "Are you sure you want to continue? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${RED}❌ Cleanup cancelled${NC}"
        exit 0
    fi
    
    load_config
    
    # Show initial disk usage
    show_disk_usage
    
    # Run all cleanup tasks
    clean_dnf
    remove_old_kernels
    clean_flatpak
    clean_temp_files
    clean_logs
    clean_dev_caches
    clean_thumbnails
    clean_package_cache_aggressive
    optimize_system
    
    # Show summary
    show_summary
}

# Quick cleanup mode
quick_cleanup() {
    print_header
    echo -e "${YELLOW}🚀 Running Quick Cleanup Mode${NC}\n"
    
    load_config
    
    # Show initial disk usage
    show_disk_usage
    
    # Run essential cleanup
    clean_dnf
    remove_old_kernels
    clean_temp_files
    clean_logs
    clean_thumbnails
    optimize_system
    
    # Show summary
    show_summary
}

# Safe cleanup mode
safe_cleanup() {
    print_header
    echo -e "${GREEN}🔒 Running Safe Cleanup Mode${NC}\n"
    
    load_config
    
    # Disable potentially dangerous options
    local original_kernels=$REMOVE_OLD_KERNELS
    local original_browsers=$CLEAN_BROWSERS
    REMOVE_OLD_KERNELS=0
    CLEAN_BROWSERS=0
    
    # Show initial disk usage
    show_disk_usage
    
    # Run safe cleanup
    clean_dnf
    clean_temp_files
    clean_logs
    clean_thumbnails
    optimize_system
    
    # Restore original values
    REMOVE_OLD_KERNELS=$original_kernels
    CLEAN_BROWSERS=$original_browsers
    
    # Show summary
    show_summary
}

# Custom cleanup mode
custom_cleanup() {
    print_header
    echo -e "${MAGENTA}🎛️  Running Custom Cleanup Mode${NC}\n"
    
    load_config
    
    echo "Select cleanup tasks to run:"
    echo "1) Clean DNF cache"
    echo "2) Remove old kernels"
    echo "3) Clean temporary files"
    echo "4) Clean system logs"
    echo "5) Clean Flatpak"
    echo "6) Clean development caches"
    echo "7) Clean thumbnail caches"
    echo "8) All of the above"
    echo "9) Cancel"
    
    read -p "Enter choices (comma separated): " choices
    
    # Show initial disk usage
    show_disk_usage
    
    IFS=',' read -ra ADDR <<< "$choices"
    for i in "${ADDR[@]}"; do
        case $i in
            1) clean_dnf ;;
            2) remove_old_kernels ;;
            3) clean_temp_files ;;
            4) clean_logs ;;
            5) clean_flatpak ;;
            6) clean_dev_caches ;;
            7) clean_thumbnails ;;
            8)
                clean_dnf
                remove_old_kernels
                clean_temp_files
                clean_logs
                clean_flatpak
                clean_dev_caches
                clean_thumbnails
                optimize_system
                ;;
            9)
                echo -e "${RED}❌ Custom cleanup cancelled${NC}"
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid choice: $i${NC}"
                ;;
        esac
    done
    
    # Show summary
    show_summary
}

# Show help
show_help() {
    echo -e "${BOLD}🛠️  Fedora Ultimate Cleanup Tool v$VERSION${NC}"
    echo -e "A comprehensive system cleanup utility for Fedora\n"
    
    echo -e "${BOLD}USAGE:${NC}"
    echo -e "  ${BOLD}sudo cleanall${NC} [OPTION]\n"
    
    echo -e "${BOLD}OPTIONS:${NC}"
    echo -e "  ${BOLD}--full, -f${NC}      Full system cleanup (aggressive)"
    echo -e "  ${BOLD}--quick, -q${NC}     Quick cleanup (standard)"
    echo -e "  ${BOLD}--safe, -s${NC}      Safe cleanup (conservative)"
    echo -e "  ${BOLD}--custom, -u${NC}    Custom cleanup (choose tasks)"
    echo -e "  ${BOLD}--config, -c${NC}    Edit configuration file"
    echo -e "  ${BOLD}--log, -l${NC}       View cleanup log"
    echo -e "  ${BOLD}--stats, -t${NC}     Show cleanup statistics"
    echo -e "  ${BOLD}--reset, -r${NC}     Reset configuration to default"
    echo -e "  ${BOLD}--help, -h${NC}      Show this help message"
    echo -e "  ${BOLD}--version, -v${NC}   Show version information\n"
    
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo -e "  ${BOLD}sudo cleanall --full${NC}    # Full system cleanup"
    echo -e "  ${BOLD}sudo cleanall --quick${NC}   # Quick cleanup"
    echo -e "  ${BOLD}sudo cleanall --safe${NC}    # Safe cleanup"
    echo -e "  ${BOLD}sudo cleanall --custom${NC}  # Custom cleanup"
    echo -e "  ${BOLD}sudo cleanall --stats${NC}   # Show disk usage\n"
    
    echo -e "${YELLOW}⚠️  WARNING:${NC}"
    echo -e "  Some operations may remove important cached data."
    echo -e "  Always backup important files before running full cleanup."
    echo -e "  Run ${BOLD}--safe${NC} mode first to test.\n"
    
    echo -e "${GREEN}✅ FEATURES:${NC}"
    echo -e "  • Automatic log rotation"
    echo -e "  • Configurable cleanup options"
    echo -e "  • Multiple cleanup modes"
    echo -e "  • Disk usage reporting"
    echo -e "  • System optimization"
    echo -e "  • Development cache cleaning"
}

# Other functions (show_version, show_stats, edit_config, view_log) remain same
# ... [पिछले functions वही रहेंगे]

# Main execution
case "$1" in
    "--full"|"-f")
        full_cleanup
        ;;
    "--quick"|"-q")
        quick_cleanup
        ;;
    "--safe"|"-s")
        safe_cleanup
        ;;
    "--custom"|"-u")
        custom_cleanup
        ;;
    "--config"|"-c")
        edit_config
        ;;
    "--log"|"-l")
        view_log
        ;;
    "--stats"|"-t")
        show_stats
        ;;
    "--reset"|"-r")
        reset_config
        ;;
    "--version"|"-v")
        show_version
        ;;
    "--help"|"-h"|"")
        show_help
        ;;
    *)
        echo -e "${RED}❌ Error: Unknown option '$1'${NC}"
        echo -e "Try: ${BOLD}sudo cleanall --help${NC}"
        exit 1
        ;;
esac

exit 0
